{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xawd-platform",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xawd-db",
      "database_id": "ID_DATABASE_D1_ANDA"
    }
  ]
}
